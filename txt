/*********************************************************************
 * PURCHASE DATA (ERP / DB)
 *********************************************************************/

const purchaseRows = $("Execute a SQL query").all().map(i => i.json);

/*********************************************************************
 * INVOICE JSON
 *********************************************************************/

const invoice = $("Code in JavaScript8").first().json;

/*********************************************************************
 * HELPERS
 *********************************************************************/

// Normalize vehicle numbers: strip spaces/hyphens, uppercase
function normVehicle(v) {
    return (v || "").toString().toUpperCase().replace(/[^A-Z0-9]/g, "");
}

// Normalize LR numbers: extract leading numeric part, strip leading zeros
function normLR(v) {
    if (v === null || v === undefined) return "";
    const match = v.toString().match(/\d+/);
    if (!match) return "";
    return String(parseInt(match[0], 10));
}

// Normalize numeric strings like "89950.00" -> 89950
function normNum(v) {
    if (v === null || v === undefined) return NaN;
    return Number(v.toString().replace(/,/g, ""));
}

/*********************************************************************
 * RESULT OBJECT
 *********************************************************************/

const result = {
    invoice_number: invoice.invoice_number,
    fo_number: invoice.fo_no,
    status: "PASS",

    summary: {
        purchase_rows: purchaseRows.length,
        invoice_trucks: invoice.line_items.length
    },

    passed: [],
    failed: [],
    warnings: []
};

/*********************************************************************
 * BASIC CHECKS (Header Level)
 *********************************************************************/

// FO Number  (invoice.fo_no -> db.freight_order)

const dbFO = purchaseRows.length ? purchaseRows[0].freight_order : "";
const invoiceFO = invoice.fo_no;

if (dbFO === invoiceFO) {
    result.passed.push("FO Number Matched");
} else {
    result.failed.push({
        check: "FO Number",
        invoice_data: invoiceFO,
        erp_data: dbFO
    });
}

// FO Rate  (invoice.fo_rate -> db.rate)  -- only if present at header level

if (invoice.fo_rate !== undefined) {

    const dbRate = purchaseRows.length ? normNum(purchaseRows[0].rate) : NaN;
    const invoiceRate = normNum(invoice.fo_rate);

    if (dbRate === invoiceRate) {
        result.passed.push("FO Rate Matched");
    } else {
        result.failed.push({
            check: "FO Rate",
            invoice_data: invoiceRate,
            erp_data: dbRate
        });
    }
}

// FO Qty  (invoice.fo_qty -> db.qty)

if (invoice.fo_qty !== undefined) {

    const dbQty = purchaseRows.length ? Number(purchaseRows[0].qty) : 0;
    const invoiceQty = Number(invoice.fo_qty);

    if (dbQty === invoiceQty) {
        result.passed.push("FO Qty Matched");
    } else {
        result.failed.push({
            check: "FO Qty",
            invoice_data: invoiceQty,
            erp_data: dbQty
        });
    }
}

// FO Order Value  (invoice.fo_order_value -> db.total_value)

if (invoice.fo_order_value !== undefined) {

    const dbTotal = purchaseRows.length ? normNum(purchaseRows[0].total_value) : 0;
    const invoiceTotal = normNum(invoice.fo_order_value);

    if (dbTotal === invoiceTotal) {
        result.passed.push("FO Order Value Matched");
    } else {
        result.failed.push({
            check: "FO Order Value",
            invoice_data: invoiceTotal,
            erp_data: dbTotal
        });
    }
}

/*********************************************************************
 * INDEX PURCHASE ROWS BY sale_bill_number (matching key)
 *********************************************************************/

const purchaseMap = {};
const duplicateBill = [];
const seen = {};

for (const row of purchaseRows) {

    const key = row.sale_bill_number;

    if (!seen[key]) seen[key] = 0;
    seen[key]++;

    purchaseMap[key] = {
        sale_bill_number: row.sale_bill_number,
        vehicle_no: row.vehicle_no,
        lr_no: row.lr_no,
        freight_order: row.freight_order,
        rate: normNum(row.rate),
        qty: Number(row.qty)
    };
}

Object.entries(seen).forEach(([k, v]) => {
    if (v > 1) {
        duplicateBill.push({ sale_bill_number: k, rows: v });
    }
});

if (duplicateBill.length) {
    result.warnings.push({
        check: "Duplicate Sale Bill Numbers In ERP",
        data: duplicateBill
    });
}

/*********************************************************************
 * VALIDATE EVERY TRUCK (matched by our_invoice_number -> sale_bill_number)
 *********************************************************************/

const matchedBillNumbers = [];

for (const truck of invoice.line_items) {

    const billNo = truck.our_invoice_number;

    matchedBillNumbers.push(billNo);

    const purchase = purchaseMap[billNo];

    if (!purchase) {

        result.failed.push({
            check: "Sale Bill Number Missing",
            invoice_data: billNo,
            note: "our_invoice_number present in invoice but no matching sale_bill_number found in ERP"
        });

        continue;
    }

    //--------------------------------
    // VEHICLE NUMBER  (invoice.truck_no -> db.vehicle_no)

    if (normVehicle(purchase.vehicle_no) !== normVehicle(truck.truck_no)) {

        result.failed.push({
            check: "Vehicle",
            sale_bill_number: billNo,
            invoice_data: truck.truck_no,
            erp_data: purchase.vehicle_no
        });

    }

    //--------------------------------
    // LR / CN NUMBER  (invoice.lr_no -> db.lr_no)

    if (normLR(purchase.lr_no) !== normLR(truck.lr_no)) {

        result.failed.push({
            check: "LR/CN Number",
            sale_bill_number: billNo,
            invoice_data: truck.lr_no,
            erp_data: purchase.lr_no
        });

    }

    //--------------------------------
    // FO NUMBER (per truck)  (invoice.fo_no -> db.freight_order)

    if (purchase.freight_order !== truck.fo_no) {

        result.failed.push({
            check: "FO Number",
            sale_bill_number: billNo,
            invoice_data: truck.fo_no,
            erp_data: purchase.freight_order
        });

    }

    //--------------------------------
    // FREIGHT / RATE  (invoice.freight -> db.rate)

    if (purchase.rate !== normNum(truck.freight)) {

        result.failed.push({
            check: "Freight Rate",
            sale_bill_number: billNo,
            invoice_data: normNum(truck.freight),
            erp_data: purchase.rate
        });

    }

    //--------------------------------

    result.passed.push(billNo + " Validated");

}

/*********************************************************************
 * MISSING PURCHASE VOUCHERS (in ERP but not in invoice)
 *********************************************************************/

Object.keys(purchaseMap).forEach(billNo => {

    if (!matchedBillNumbers.includes(billNo)) {

        result.failed.push({
            check: "ERP Sale Bill Missing In Invoice",
            sale_bill_number: billNo,
            note: "sale_bill_number present in ERP purchase data but not found in invoice"
        });

    }

});

/*********************************************************************
 * TRUCK COUNT
 *********************************************************************/

const expectedTruck = purchaseRows.length ? purchaseRows.length : 0;
const invoiceTruck = invoice.line_items.length;

if (expectedTruck !== invoiceTruck) {

    result.failed.push({
        check: "Truck Count",
        invoice_data: invoiceTruck,
        erp_data: expectedTruck
    });

} else {
    result.passed.push("Truck Count Matched");
}

/*********************************************************************
 * FINAL STATUS
 *********************************************************************/

if (result.failed.length) {
    result.status = "FAILED";
}

/*********************************************************************
 * RETURN
 *********************************************************************/

return [
    {
        json: result
    }
];


/*********************************************************************
 * PURCHASE DATA
 *********************************************************************/
const purchaseRows = $("Execute a SQL query").all().map(i => i.json);

/*********************************************************************
 * HELPER: NORMALIZE CODE-LIKE VALUES (e.g. "KOL/00279" vs "279")
 * Strips any non-digit characters and leading zeros so different
 * formats of the same number are treated as equal.
 *********************************************************************/
function normalizeCode(value) {
    if (value === null || value === undefined) return "";
    const digitsOnly = String(value).replace(/\D/g, "");
    return digitsOnly.replace(/^0+/, "") || "0";
}

/*********************************************************************
 * INVOICE JSON
 *********************************************************************/
const invoice = $("Code in JavaScript8").first().json;

/*********************************************************************
 * RESULT OBJECT
 *********************************************************************/
const result = {
    invoice_number: invoice.invoice_number,
    fo_number: invoice.fo_no,
    status: "PASS",

    summary: {
        purchase_rows: purchaseRows.length,
        invoice_trucks: invoice.line_items.length
    },

    passed: [],
    failed: [],
    warnings: []
};

/*********************************************************************
 * BASIC CHECKS
 *********************************************************************/

// 1. FO Number
const dbFO = purchaseRows.length ? purchaseRows[0].freight_order : "";

if (dbFO === invoice.fo_no) {
    result.passed.push("FO Number Matched");
} else {
    result.failed.push({
        check: "FO Number",
        invoice_data: invoice.fo_no,
        erp_data: dbFO
    });
}

// 2. FO Rate Check
const dbRate = purchaseRows.length ? Number(purchaseRows[0].rate) : 0;
const invoiceRate = Number(invoice.fo_rate || 0);

if (dbRate === invoiceRate) {
    result.passed.push("FO Rate Matched");
} else {
    result.failed.push({
        check: "FO Rate",
        invoice_data: invoiceRate,
        erp_data: dbRate
    });
}

// 3. FO Order Value Check
const dbOrderValue = purchaseRows.length ? Number(purchaseRows[0].total_value) : 0;
const invoiceOrderValue = Number(invoice.fo_order_value || 0);

if (dbOrderValue === invoiceOrderValue) {
    result.passed.push("FO Order Value Matched");
} else {
    result.failed.push({
        check: "FO Order Value",
        invoice_data: invoiceOrderValue,
        erp_data: dbOrderValue
    });
}

/*********************************************************************
 * TOTAL VALUE
 *********************************************************************/
const dbTotal = purchaseRows.length ? Number(purchaseRows[0].total_value) : 0;
const invoiceTotal = Number(invoice.fo_order_value || invoice.taxable_value || 0);

// Calculate the absolute difference between the two amounts
const totalDifference = Math.abs(dbTotal - invoiceTotal);

// If the mismatch is less than or equal to 80 rupees, it is considered valid
if (totalDifference <= 80) {
    result.passed.push("Invoice Amount Matched");
} else {
    result.failed.push({
        check: "Invoice Amount",
        invoice_data: invoiceTotal,
        erp_data: dbTotal
    });
}

/*********************************************************************
 * GROUP PURCHASE DATA BY VOUCHER
 *********************************************************************/
const purchaseMap = {};

for (const row of purchaseRows) {
    if (!purchaseMap[row.voucher_no]) {
        purchaseMap[row.voucher_no] = {
            voucher_no: row.voucher_no,
            vehicle_no: row.vehicle_no,
            lr_no: row.lr_no,
            freight_order: row.freight_order,
            rate: Number(row.rate),
            qty: Number(row.qty),
            item_codes: []
        };
    }
    purchaseMap[row.voucher_no].item_codes.push(row.item_code);
}

/*********************************************************************
 * DUPLICATE VOUCHERS
 *********************************************************************/
const duplicateVoucher = [];
const seen = {};

for (const r of purchaseRows) {
    if (!seen[r.voucher_no]) {
        seen[r.voucher_no] = 0;
    }
    seen[r.voucher_no]++;
}

Object.entries(seen).forEach(([k, v]) => {
    if (v > 1) {
        duplicateVoucher.push({
            voucher: k,
            rows: v
        });
    }
});

if (duplicateVoucher.length) {
    result.warnings.push({
        check: "Duplicate Purchase Rows",
        data: duplicateVoucher
    });
}

/*********************************************************************
 * VALIDATE EVERY TRUCK
 *********************************************************************/
const matchedVoucher = [];

for (const truck of invoice.line_items) {
    // Some invoices label the voucher/gatepass number as "our_invoice_number" instead of "gatepass_no"
    const voucher = truck.gatepass_no || truck.our_invoice_number;
    matchedVoucher.push(voucher);

    const purchase = purchaseMap[voucher];

    if (!purchase) {
        // Handle missing invoice voucher in ERP as a warning instead of a failure
        result.warnings.push({
            check: "Invoice Voucher Missing In ERP",
            data: [
                {
                    voucher: voucher,
                    note: "Voucher present in invoice but not found in ERP purchase data"
                }
            ]
        });
        continue;
    }

    //--------------------------------
    // VEHICLE NUMBER
    if (purchase.vehicle_no !== truck.truck_no) {
        result.failed.push({
            check: "Vehicle",
            voucher,
            invoice_data: truck.truck_no,
            erp_data: purchase.vehicle_no
        });
    }

    //--------------------------------
    // LR / CN NUMBER
    if (normalizeCode(purchase.lr_no) !== normalizeCode(truck.lr_no)) {
        result.failed.push({
            check: "LR/CN Number",
            voucher,
            invoice_data: truck.lr_no,
            erp_data: purchase.lr_no
        });
    }

    //--------------------------------
    // FO NUMBER (per truck)
    if (purchase.freight_order !== truck.fo_no) {
        result.failed.push({
            check: "FO Number",
            voucher,
            invoice_data: truck.fo_no,
            erp_data: purchase.freight_order
        });
    }

    //--------------------------------
    // FREIGHT / RATE
    if (purchase.rate !== Number(truck.freight)) {
        result.failed.push({
            check: "Freight",
            voucher,
            invoice_data: Number(truck.freight),
            erp_data: purchase.rate
        });
    }

    //--------------------------------
    result.passed.push(voucher + " Validated");
}

/*********************************************************************
 * MISSING PURCHASE VOUCHERS (Moved to Warnings)
 *********************************************************************/
Object.keys(purchaseMap).forEach(v => {
    if (!matchedVoucher.includes(v)) {
        result.warnings.push({
            check: "Purchase Voucher Missing In Invoice",
            data: [
                {
                    voucher: v,
                    rows: 1 
                }
            ]
        });
    }
});

/*********************************************************************
 * TRUCK COUNT (Moved to Warnings)
 *********************************************************************/
const expectedTruck = purchaseRows.length ? Number(purchaseRows[0].qty) : 0;
const invoiceTruck = invoice.line_items.length;

if (expectedTruck !== invoiceTruck) {
    result.warnings.push({
        check: "Truck Count",
        data: [
            {
                invoice_data: invoiceTruck,
                erp_data: expectedTruck,
                note: `Truck count mismatch. Invoice shows ${invoiceTruck} while ERP expects ${expectedTruck}.`
            }
        ]
    });
} else {
    result.passed.push("Truck Count Matched");
}

/*********************************************************************
 * FINAL STATUS
 *********************************************************************/
if (result.failed.length) {
    result.status = "FAILED";
}

/*********************************************************************
 * RETURN
 *********************************************************************/
return [
    {
        json: result
    }
];


