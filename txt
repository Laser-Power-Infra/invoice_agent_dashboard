  2. If NO such explicit RCM statement is found, check cgst_amount / sgst_amount / igst_amount (as extracted above).
     - If all three are null → treat this as a NON-GST bill (no GST charged).
     - If any one of them is a real non-null numeric value → treat this as a GST bill.
  3. If it is a NON-GST bill (per step 2):
     a. Take stax_code_str (first two digits of transporter_gstin).
     b. If stax_code_str = "19" (West Bengal/Kolkata) → RCM = "5%" (default — always apply, never null here).
     c. If stax_code_str is any other state code → RCM = null (unless explicit document text states otherwise).
  4. If it is a GST bill (per step 2, and no explicit RCM statement found in step 1) → RCM = null.
  5. Never return null when step 1's explicit RCM statement is found, or when step 3b's "19" + non-GST condition applies — both must always resolve to "5%".


- cgst_amount: CGST amount explicitly printed on the invoice.
  - If the field is blank, shows "NIL", or says "with consignor" → return null (do NOT return 0).
  - If a real numeric value is printed (e.g., "1250.00") → extract exactly as shown, normalized per numeric rules (e.g., "1,250.00" → 1250.00).
- sgst_amount: SGST amount explicitly printed on the invoice. Same NIL/blank/with-consignor → null rule as cgst_amount.
- igst_amount: IGST amount explicitly printed on the invoice. Same NIL/blank/with-consignor → null rule as cgst_amount.
- gst_type: Derive from which of the above is populated —
  - If igst_amount is non-null and cgst_amount/sgst_amount are null → "IGST"
  - If cgst_amount and sgst_amount are both non-null and igst_amount is null → "CGST_SGST"
  - If all three are null (NIL/blank/with consignor) → "NONE"
  - If none of CGST/SGST/IGST labels appear anywhere on the document at all → null

- Service_acc_code: Extract if visible, else null
- st_charges (invoice-level): The TOTAL of all per-row st_charges values summed across line_items (distinct from the row-level "st_charges" field inside each line_items object — this one is the invoice-wide sum). If no ST CHARGES lines are present anywhere, return null.

Output a single JSON block conforming exactly to these fields, with per-row data nested under "line_items" as described above.












/*********************************************************************
 * GRN VALIDATION (FIXED)
 *
 * INPUT 1 : Execute a SQL query (GRN + FO Engine Data)
 * INPUT 2 : Code in JavaScript8 (Invoice JSON)
 *
 * FIXES:
 *  1. FO Number check is now ALWAYS performed (previously wrapped in
 *     `if(invoice.fo_no)` -> a missing fo_no silently skipped the
 *     check and let the row PASS). Missing fo_no is now a failure.
 *
 *  2. Rate / Freight validation now supports TWO FO types instead of
 *     assuming every row is weight-based:
 *       - WEIGHT-BASED FO : erp.weight present -> rate is stored in
 *         "per-tonne" form (e.g. invoice 2250 == erp 2.25), so we
 *         scale by 1000 and multiply by weight_charged.
 *       - QTY / FIXED-RATE FO : erp.weight is null/0 (e.g. your
 *         sample: rate 8800.00, qty 1, weight null) -> rate is
 *         compared DIRECTLY (no /1000 or *1000 scaling) and
 *         freight = rate * qty.
 *     Previously the code always divided/multiplied by 1000, which
 *     is why a fixed-rate row like yours (8800 vs 8800) failed.
 *********************************************************************/

/*********************************************************************
 * ERP DATA
 *********************************************************************/

const grnRows = $("Execute a SQL query13").all().map(i => i.json);

/*********************************************************************
 * INVOICE JSON
 *********************************************************************/

const invoice = $("Code in JavaScript46").first().json;

/*********************************************************************
 * RESULT
 *********************************************************************/

const result = {

    invoice_number: invoice.invoice_number,
    transporter: invoice.transporter_name,
    status: "PASS",

    summary: {
        invoice_rows: invoice.line_items.length,
        grn_rows: grnRows.length,
        matched: 0,
        failed: 0
    },

    passed: [],
    failed: [],
    warnings: []

};

/*********************************************************************
 * HELPERS
 *********************************************************************/

function normalizeVehicle(v){
    return String(v || "")
        .replace(/[^A-Za-z0-9]/g,"")
        .toUpperCase();
}

function normalizeLR(v){
    return String(v || "").replace(/[^0-9]/g,"");
}

function round2(v){
    return Number(Number(v).toFixed(2));
}

function isWeightBasedFO(erp){
    // Weight-based FO has a real numeric weight on the GRN row.
    const w = Number(erp.weight);
    return erp.weight !== null && erp.weight !== undefined && !isNaN(w) && w > 0;
}

/*
 * Transporter codes that ship via courier / non-vehicle modes, so
 * there's no vehicle number to expect on the invoice. Add more
 * codes here as you find them (e.g. other courier transporters).
 */
const NO_VEHICLE_TRANSPORTERS = ["TOM08"];

function vehicleNotApplicable(erp){
    const code = String(erp.transporter || erp.party_code || "").trim().toUpperCase();
    return NO_VEHICLE_TRANSPORTERS.includes(code);
}

/*********************************************************************
 * MAP ERP BY BILL NUMBER
 *********************************************************************/

const grnMap = {};

for(const row of grnRows){
    grnMap[String(row.bill_number).trim()] = row;
}

/*********************************************************************
 * DUPLICATE BILL CHECK
 *********************************************************************/

const duplicate = {};

for(const row of grnRows){
    duplicate[row.bill_number] = (duplicate[row.bill_number] || 0) + 1;
}

Object.entries(duplicate).forEach(([bill,count])=>{
    if(count>1){
        result.warnings.push({
            check:"Duplicate Bill Number",
            bill_number:bill,
            rows:count
        });
    }
});

/*********************************************************************
 * VALIDATE EVERY LINE
 *********************************************************************/

for(const truck of invoice.line_items){

    const bill = truck.our_invoice_number;
    const erp = grnMap[bill];

    if(!erp){
        result.failed.push({
            bill_number:bill,
            status:"FAILED",
            reason:"Bill Number Not Found In GRN"
        });
        result.summary.failed++;
        continue;
    }

    const checks = [];

    /***************************************************
     * FO NUMBER  (always checked, missing = failure)
     ***************************************************/

    const invoiceFO = invoice.fo_no ? String(invoice.fo_no).trim() : "";
    const erpFO = erp.freight_order ? String(erp.freight_order).trim() : "";

    if(!invoiceFO){
        checks.push({
            field:"FO Number",
            match:false,
            reason:"FO Number Missing On Invoice",
            invoice: invoice.fo_no,
            erp: erp.freight_order
        });
    } else {
        checks.push({
            field:"FO Number",
            match: invoiceFO === erpFO,
            invoice: invoice.fo_no,
            erp: erp.freight_order
        });
    }

    /***************************************************
     * BILL NUMBER
     ***************************************************/

    checks.push({
        field:"Bill Number",
        match: String(erp.bill_number).trim() === String(bill).trim(),
        invoice:bill,
        erp:erp.bill_number
    });

    /***************************************************
     * LR NUMBER
     ***************************************************/

    checks.push({
        field:"LR Number",
        match: normalizeLR(truck.lr_no) === normalizeLR(erp.lr_no),
        invoice:truck.lr_no,
        erp:erp.lr_no
    });

    /***************************************************
     * VEHICLE
     ***************************************************/

    if(!truck.truck_no && vehicleNotApplicable(erp)){

        checks.push({
            field:"Vehicle",
            match:true,
            reason:"Vehicle Not Applicable (Courier Transporter)",
            invoice:truck.truck_no,
            erp:erp.vehicle_no
        });

    } else {

        checks.push({
            field:"Vehicle",
            match: normalizeVehicle(truck.truck_no) === normalizeVehicle(erp.vehicle_no),
            invoice:truck.truck_no,
            erp:erp.vehicle_no
        });

    }

    /***************************************************
     * RATE + FREIGHT
     *
     * Weight-based FO : invoice rate is "x1000" form
     *                   (e.g. invoice 2250, erp 2.25)
     * Qty/fixed-rate FO : rate compared directly
     *                   (e.g. invoice 8800, erp 8800.00)
     ***************************************************/

    const erpRate = Number(erp.rate);
    const weightBased = isWeightBasedFO(erp);

    let invoiceRate, expectedFreight;

    if(weightBased){

        invoiceRate = Number(truck.rate) / 1000;

        expectedFreight = round2(
            erpRate * 1000 * Number(truck.weight_charged)
        );

    } else {

        // Qty/fixed-rate FO: rate is NOT on the line item, it's the
        // invoice-level taxable_value (falls back to truck.rate if
        // taxable_value isn't present for some reason).
        invoiceRate = Number(
            invoice.taxable_value ?? truck.rate
        );

        const erpQty = Number(erp.qty || 1);
        const invoiceQty = Number(invoice.fo_qty ?? erpQty);

        expectedFreight = round2(erpRate * erpQty);

        if(!isNaN(invoiceQty)){
            checks.push({
                field:"Quantity",
                match: Math.abs(invoiceQty - erpQty) <= 0.0001,
                invoice:invoiceQty,
                erp:erpQty
            });
        }

    }

    if(isNaN(invoiceRate)){
        checks.push({
            field:"Rate",
            match:false,
            reason:"Rate Not Found On Invoice",
            fo_type: weightBased ? "weight_based" : "qty_based",
            erp:erpRate
        });
    } else {
        checks.push({
            field:"Rate",
            match: Math.abs(invoiceRate - erpRate) <= 0.0001,
            fo_type: weightBased ? "weight_based" : "qty_based",
            invoice:invoiceRate,
            erp:erpRate
        });
    }

    /*
     * Freight can show up under different labels depending on how the
     * transporter bills (net of ST charges vs. gross taxable value),
     * so we check MULTIPLE candidate values from the invoice and pass
     * if ANY ONE of them matches the ERP-expected freight.
     */

    const freightCandidates = [
        { label:"truck.freight",        value: truck.freight },
        { label:"bill_freight_val",     value: invoice.bill_freight_val },
        { label:"taxable_value",        value: invoice.taxable_value }
    ]
    .filter(c => c.value !== undefined && c.value !== null && c.value !== "")
    .map(c => ({ label:c.label, value: round2(c.value) }));

    const freightMatch = freightCandidates.find(
        c => Math.abs(expectedFreight - c.value) <= 1
    );

    // Keep invoiceFreight for the passed-row summary: prefer the
    // matching value, otherwise fall back to truck.freight (or the
    // first available candidate) for reporting purposes.
    const invoiceFreight = freightMatch
        ? freightMatch.value
        : round2(truck.freight ?? freightCandidates[0]?.value ?? 0);

    checks.push({
        field:"Freight",
        match: !!freightMatch,
        fo_type: weightBased ? "weight_based" : "qty_based",
        expected:expectedFreight,
        checked: freightCandidates
    });

    /***************************************************
     * RESULT
     ***************************************************/

    const errors = checks.filter(c => !c.match);
    const matchSummary = {
        total: checks.length,
        matched: checks.length - errors.length,
        not_matched: errors.length
    };

    if(errors.length){

        result.failed.push({
            bill_number:bill,
            grn_number:erp.grn_number,
            match_summary: matchSummary,
            errors
        });

        result.summary.failed++;

    } else {

        result.passed.push({
            bill_number:bill,
            grn_number:erp.grn_number,
            vehicle:truck.truck_no,
            lr_no:truck.lr_no,
            freight:invoiceFreight,
            match_summary: matchSummary,
            status:"PASS"
        });

        result.summary.matched++;
    }
}

/*********************************************************************
 * OVERALL STATUS
 *********************************************************************/

if(result.failed.length){
    result.status="FAILED";
}

/*********************************************************************
 * RETURN
 *********************************************************************/

return [
{
json:result
}
];


